{
  "name": "local-ai-studio",
  "version": "0.1.5",
  "private": true,
  "description": "Local-first RAG and fine-tuning desktop studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:windows": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder --linux AppImage --win nsis"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
